#!/usr/bin/env bash
# Copies Curb's data tables (MOT inspections, recalls, bulletins, maintenance guides, rate tables) from this machine's
# development database to the production database on the server. Everything people make on the live site is left
# out entirely: accounts, sign-ins, saved reports, plan usage, garages and their photos, Our Garage threads, plus
# feature switches and the error log. So the server's own users and their content are never touched, and this
# machine's demo login never reaches the live site. Migration records stay the server's own too.
#
# Usage: bin/copy-data-to-server (CURB_SERVER=<ip> to copy to a different server)
# Deploy first (`bin/kamal setup` or `bin/kamal deploy`) so the server has the same migrations as this machine. The
# copy replaces the server's data tables; pages may error for the few minutes it runs. It is several GB, so expect it
# to take a while on a home connection.
set -euo pipefail

server="${CURB_SERVER:-138.197.142.166}"
source_db="${SOURCE_DB:-curb_app_development}"
dump="tmp/curb-data.dump"

echo "Dumping ${source_db} (without accounts, reports or migration records)..."
pg_dump --format=custom --no-owner --no-privileges \
  --exclude-table=users --exclude-table=sessions --exclude-table=reports --exclude-table=usage_events \
  --exclude-table=users_id_seq --exclude-table=sessions_id_seq --exclude-table=reports_id_seq --exclude-table=usage_events_id_seq \
  --exclude-table=feature_flags --exclude-table=feature_flags_id_seq --exclude-table=error_events --exclude-table=error_events_id_seq \
  --exclude-table=garage_cars --exclude-table=garage_cars_id_seq --exclude-table=garage_accessories --exclude-table=garage_accessories_id_seq --exclude-table=accessory_placements --exclude-table=accessory_placements_id_seq --exclude-table=forum_threads --exclude-table=forum_threads_id_seq --exclude-table=forum_posts --exclude-table=forum_posts_id_seq --exclude-table=forum_reports --exclude-table=forum_reports_id_seq --exclude-table=active_storage_blobs --exclude-table=active_storage_blobs_id_seq --exclude-table=active_storage_attachments --exclude-table=active_storage_attachments_id_seq --exclude-table=active_storage_variant_records --exclude-table=active_storage_variant_records_id_seq \
  --exclude-table=schema_migrations --exclude-table=ar_internal_metadata \
  --file="${dump}" "${source_db}"
ls -lh "${dump}"

echo "Sending it to ${server} and restoring into curb_app_production..."
# Keep-alives notice a dropped connection within a few minutes, instead of waiting on it forever. One transaction:
# if anything fails, the server keeps the data it had rather than a half-replaced copy.
ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=6 "root@${server}" "docker exec -i curb-db pg_restore --username=curb --dbname=curb_app_production \
  --clean --if-exists --no-owner --no-privileges --single-transaction" < "${dump}"

rm -f "${dump}"
echo "Done. Check the site, then: bin/kamal app exec 'bin/rails runner \"puts Vehicle.count\"'"
