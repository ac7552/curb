<% content_for :title, "Create your account" %>
<main class="page page--narrow">
  <div class="stack" style="--stack: 28px">
    <div class="stack" style="--stack: 10px">
      <h1 class="display display--md">Create your account</h1>
      <p class="muted">Save every car you check and share them with anyone.</p>
    </div>

    <%= form_with model: @user, url: registration_path, class: "form form--tight" do |form| %>
      <%= render "shared/errors", record: @user %>
      <div class="fields">
        <div class="field">
          <%= form.label :first_name %>
          <%= form.text_field :first_name, required: true, autofocus: true, autocomplete: "given-name", maxlength: 60, class: "input" %>
        </div>
        <div class="field">
          <%= form.label :last_name %>
          <%= form.text_field :last_name, required: true, autocomplete: "family-name", maxlength: 60, class: "input" %>
        </div>
      </div>
      <div class="field">
        <%= form.label :email_address, "Email" %>
        <%= form.email_field :email_address, required: true, autocomplete: "username", placeholder: "you@example.com", class: "input" %>
      </div>
      <div class="field">
        <%= form.label :password %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8, maxlength: 72, class: "input" %>
        <span class="field__hint">At least 8 characters</span>
      </div>
      <div class="field">
        <%= form.label :password_confirmation, "Confirm password" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
      </div>
      <%= form.submit "Create account", class: "btn btn--dark btn--block" %>
    <% end %>

    <p class="small muted center">Already have an account? <%= link_to "Sign in", new_session_path %></p>
  </div>
</main>
