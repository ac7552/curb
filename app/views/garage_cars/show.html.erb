<% content_for :title, @car.name %>
<main class="page garage">
  <p class="eyebrow"><%= link_to "My Garage", garage_cars_path %> · <%= @car.title %></p>
  <div class="row row--between">
    <h1 class="display display--md"><%= @car.name %></h1>
    <%= link_to "Edit", edit_garage_car_path(@car), class: "btn btn--ghost btn--sm" %>
  </div>

  <div data-controller="accessory-editor" data-action="spin:turned->accessory-editor#turned">
  <section class="section--tight" aria-label="360° view">
    <% if @photos.any? %>
      <div class="spin" data-controller="spin" data-spin-frames-value="<%= @photos.size %>" tabindex="0"
           aria-label="<%= @car.name %>, <%= @photos.size %> photos. Drag or use the arrow keys to turn it."
           data-action="pointerdown->spin#grab keydown->spin#key">
        <% @photos.each_with_index do |photo, index| %>
          <figure class="spin__frame <%= "is-on" if index.zero? %>" data-spin-target="frame" data-photo-id="<%= photo.id %>">
            <%= image_tag url_for(photo), alt: "", draggable: false, decoding: "async" %>
            <%= render "garage_cars/overlays", accessories: @accessories, photo: %>
          </figure>
        <% end %>
        <p class="spin__hint" data-spin-target="hint"><%= @photos.size > 1 ? "← Drag to turn →" : "Add more photos to turn it" %></p>
        <p class="spin__count"><span data-spin-target="count">1</span> / <%= @photos.size %></p>
      </div>
    <% else %>
      <div class="empty garage__start">
        <p class="h2">Spin your car 360°</p>
        <p class="muted">Film a slow walk around your car. Curb turns it into a view you can spin, right on your phone.</p>
      </div>
    <% end %>
  </section>

  <section class="section--tight garage__upload">
    <%# A walk-around video becomes the spin's photos on the phone; only the frames are uploaded. It replaces the
        photos already there, so the spin is one smooth loop. %>
    <%= form_with url: garage_car_photos_path(@car), multipart: true, data: { controller: "walkaround" } do |form| %>
      <%= hidden_field_tag :replace, "1" %>
      <%= file_field_tag "photos[]", multiple: true, class: "sr-only", tabindex: -1, aria: { hidden: true }, data: { walkaround_target: "frames" } %>
      <label class="btn btn--dark garage__pick">
        Film a walk-around
        <%= file_field_tag :walkaround_video, accept: "video/*", capture: "environment", class: "sr-only",
                           data: { walkaround_target: "video", action: "change->walkaround#pick" } %>
      </label>
      <span class="small faint" data-walkaround-target="status"><%= @photos.any? ? "Replaces the photos above." : "Takes about 15 seconds." %></span>
    <% end %>
    <%= form_with url: garage_car_photos_path(@car), multipart: true, data: { controller: "photo-resize" } do |form| %>
      <label class="btn btn--ghost btn--sm garage__pick">
        <%= @photos.any? ? "Add photos" : "Or choose photos" %>
        <%= form.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "sr-only",
                            data: { photo_resize_target: "input", action: "change->photo-resize#prepare" } %>
      </label>
      <span class="small faint" data-photo-resize-target="status">Up to <%= GarageCar::MAX_PHOTOS %>, in the order you walked around.</span>
    <% end %>
    <details class="garage__tips">
      <summary class="small muted">How to film a good walk-around</summary>
      <ul class="small muted">
        <li>Hold the phone sideways, at chest height.</li>
        <li>Stay the same distance from the car all the way round, about two big steps.</li>
        <li>Walk at a steady pace for 10–20 seconds, and finish where you started.</li>
        <li>Film in even light: avoid strong sun right behind the car.</li>
        <li>Mind the license plate if you'll share pictures.</li>
      </ul>
    </details>
  </section>

  <% if @photos.any? %>
    <details class="more garage__photos">
      <summary><span>Photos</span><span class="more__hint"><%= pluralize(@photos.size, "photo") %></span></summary>
      <ol class="garage__strip">
        <% @photos.each do |photo| %>
          <li>
            <%= image_tag url_for(photo), alt: "", loading: "lazy" %>
            <%= button_to "Remove", garage_car_photo_path(@car, photo), method: :delete, class: "link-btn",
                          form: { data: { turbo_confirm: "Remove this photo?" } } %>
          </li>
        <% end %>
      </ol>
    </details>
  <% end %>

  <%= render "garage_cars/accessories", car: @car, accessories: @accessories, photos: @photos %>

  <% room = ForumRoom.for(@car) %>
  <section class="section garage__room">
    <h2 class="eyebrow about__head">Our Garage</h2>
    <p><%= link_to "Talk with other #{room.title} owners →", community_room_path(room.make_slug, room.model_slug) %></p>
  </section>
  </div>
</main>
