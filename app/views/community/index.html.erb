<% content_for :title, "Our Garage" %>
<main class="page forum">
  <%= render "community/tabs" %>
  <h1 class="display display--md">Our Garage</h1>
  <p class="lede">Talk with people who drive what you drive. Pick a maker, then your model.</p>

  <% if @my_rooms.any? %>
    <section class="section--tight">
      <h2 class="eyebrow about__head">Your cars' rooms</h2>
      <div class="chips">
        <% @my_rooms.each do |room| %><%= link_to room.title, community_room_path(room.make_slug, room.model_slug), class: "chip chip--link" %><% end %>
      </div>
    </section>
  <% end %>

  <section class="section">
    <h2 class="eyebrow about__head">Makers</h2>
    <ul class="forum__makes">
      <% @makes.each do |make| %>
        <% key = VehicleName.make_key(make[:name]) %>
        <li>
          <%= link_to community_make_path(ForumRoom.slug(key)), class: "forum__make" do %>
            <% if make[:logo] %><%= image_tag make[:logo], alt: "", class: "make-logo", loading: "lazy" %><% else %><span class="make-logo make-logo--mono"><%= make[:name].first %></span><% end %>
            <span><%= make[:name] %></span>
            <span class="small faint"><%= pluralize(@thread_counts.fetch(key, 0), "thread") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @latest.any? %>
    <section class="section">
      <h2 class="eyebrow about__head">Latest</h2>
      <%= render "community/threads", threads: @latest, show_room: true %>
    </section>
  <% end %>
</main>
