# Secrets Kamal passes to the containers. This file is committed, so it only says where each value comes from;
# never paste a value here.

# Unlocks config/credentials.yml.enc (the Anthropic and MOT API keys).
RAILS_MASTER_KEY=$(cat config/master.key)

# Set once in your shell or password manager, e.g. export CURB_DATABASE_PASSWORD=$(openssl rand -hex 24)
CURB_DATABASE_PASSWORD=$CURB_DATABASE_PASSWORD
POSTGRES_PASSWORD=$CURB_DATABASE_PASSWORD

# Cloudflare's origin certificate and its private key, saved outside the repo when you made them (docs/deploy.md).
CLOUDFLARE_ORIGIN_CERT=$(cat ~/.config/curb/cloudflare-origin.pem)
CLOUDFLARE_ORIGIN_KEY=$(cat ~/.config/curb/cloudflare-origin-key.pem)
